# ── 管理台配置（复制为 admin/.env）─────────────────────────────
# 与门户共用同一个 PostgreSQL —— 这是两个应用之间唯一的数据通道。
DATABASE_URL=postgresql://pps:pps_dev_pw@localhost:5433/pps2026

# 管理台会话签名密钥（cookie: pps_console）— 必须与门户的 NUXT_SESSION_SECRET 不同
NUXT_CONSOLE_SESSION_SECRET=dev-only-console-secret-change-me

# 门户地址（参会人凭证 QR 的「查看 QR」跳转目标）
# NUXT_PUBLIC_PORTAL_URL=http://localhost:3000

# ── 数据库备份 ────────────────────────────────────────────────
# 定时备份间隔（小时）；0 = 关闭定时（仍可手动备份）
BACKUP_INTERVAL_HOURS=24
# 备份保留份数（超出自动清理最旧的）
BACKUP_KEEP=14
# 备份输出目录（默认 admin/backups，已加入 .gitignore）
# BACKUP_DIR=
# 运行 pg_dump 的 Docker 容器名（管理台通过 docker exec 调用 pg_dump）
BACKUP_DOCKER_CONTAINER=pps-postgres

# ── 审稿结果邮件（【FILL】后真实发信；留空则日志输出）──────────
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM=
