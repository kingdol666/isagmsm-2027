# Database (local dev via docker compose)
DATABASE_URL=postgresql://pps:pps_dev_pw@localhost:5433/pps2026

# Admin session signing secret (change in production)
NUXT_SESSION_SECRET=dev-only-session-secret-change-me

# Mock payment webhook HMAC secret (dev)
NUXT_MOCK_PAYMENT_SECRET=dev-only-mock-secret

# Public site
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- WeChat Pay v3 (Native / PC QR). Provider activates only when ALL set. ----
WECHAT_MCH_ID=
WECHAT_APP_ID=
# Merchant private key PEM (\n-escaped single line is accepted)
WECHAT_PRIVATE_KEY=
# Merchant certificate serial number
WECHAT_CERT_SERIAL=
# APIv3 key (32 chars) — used for webhook resource decryption (AES-256-GCM)
WECHAT_API_V3_KEY=
# Platform certificates (public keys) used to verify webhook signatures.
# Multiple PEMs separated by the literal marker ---SPLIT---
WECHAT_PLATFORM_CERTS=
# Public https URL of the notify endpoint, e.g. https://your.domain/api/payments/webhook/wechat
WECHAT_NOTIFY_URL=

# ---- Alipay (RSA2). Provider activates only when ALL set. ----
ALIPAY_APP_ID=
# Application private key PEM (\n-escaped single line is accepted)
ALIPAY_PRIVATE_KEY=
# Alipay platform public key PEM — verifies async-notify signatures
ALIPAY_PUBLIC_KEY=
# Public https URL of the async notify endpoint
ALIPAY_NOTIFY_URL=
# Optional: official gateway only (openapi.alipay.com or openapi-sandbox.dl.alipaydev.com)
ALIPAY_GATEWAY=

# ---- Seed admin accounts (dev only — change before any real deployment) ----
ADMIN_PASSWORD=
STAFF_PASSWORD=
