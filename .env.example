# ════════════════════════════════════════════════════════════════
#  ISAGMSM 2027 — DEPLOYMENT CONFIGURATION
#  Copy to .env and fill in the values marked 【FILL】.
#  Everything works out of the box in dev mode without any of the
#  optional blocks (mock payment + on-screen verification codes).
# ════════════════════════════════════════════════════════════════

# ── 1. DATABASE (required) ───────────────────────────────────────
# Local dev via docker compose (docker compose up -d):
DATABASE_URL=postgresql://pps:pps_dev_pw@localhost:5433/pps2026

# ── 2. SITE (required) ───────────────────────────────────────────
# Public https URL — used in QR codes, verification links and emails
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 3. SECRETS (required in production) ──────────────────────────
# Session signing secret — any long random string
NUXT_SESSION_SECRET=dev-only-session-secret-change-me
# Mock payment webhook HMAC secret (dev)
NUXT_MOCK_PAYMENT_SECRET=dev-only-mock-secret

# ── 4. ADMIN ACCOUNTS (seed) ─────────────────────────────────────
# Passwords used by `pnpm db:seed` for the admin/staff accounts.
# Dev defaults: admin / pps26-admin · staff / pps26-staff
# admin 登录独立管理台（admin/，端口 3001）；staff 仅用于官网 /scan 扫码。
ADMIN_PASSWORD=
STAFF_PASSWORD=

# ── 4.5 管理台（admin/，独立应用）───────────────────────────────
# 复制 admin/.env.example 为 admin/.env 并填写：
#   DATABASE_URL                  与门户共用同一个库
#   NUXT_CONSOLE_SESSION_SECRET   管理台会话密钥（务必与 NUXT_SESSION_SECRET 不同）
#   MAIL_SMTP_* / MAIL_FROM       审稿结果邮件（选填，留空则仅日志）

# ── 5. EMAIL — verification codes (【FILL】to send real email) ────
# Without these the app runs in DEV mode: codes are printed in the
# server log AND shown on-screen (devCode). Fill all four to switch
# to real email delivery automatically.
MAIL_SMTP_HOST=            # e.g. smtp.exmail.qq.com / smtp.gmail.com
MAIL_SMTP_PORT=587         # 465 → secure=true, 587 → STARTTLS
MAIL_SMTP_SECURE=false     # true for port 465
MAIL_SMTP_USER=            # SMTP account
MAIL_SMTP_PASS=            # SMTP password / auth code
MAIL_FROM=                 # e.g. "ISAGMSM 会议 <no-reply@your-domain.org>"

# ── 6. WECHAT PAY v3 — Native QR (【FILL】to activate WeChat Pay) ──
# The provider activates automatically when ALL of these are set.
# Merchant platform: pay.weixin.qq.com → API safety
WECHAT_MCH_ID=             # mch_id
WECHAT_APP_ID=             # appid (public account / mini program)
WECHAT_PRIVATE_KEY=        # API certificate private key PEM (\n-escaped single line OK)
WECHAT_CERT_SERIAL=        # API certificate serial number
WECHAT_API_V3_KEY=         # APIv3 key (32 chars) — decrypts webhooks
# Platform certificates (public keys) to VERIFY webhook signatures.
# Multiple PEMs separated by the literal marker ---SPLIT---
WECHAT_PLATFORM_CERTS=
# Public notify URL, e.g. https://your-domain.org/api/payments/webhook/wechat
WECHAT_NOTIFY_URL=

# ── 7. ALIPAY — RSA2（【FILL】激活支付宝在线扫码支付）─────────────
# 支付流程：报名 → 支付页选「支付宝」→ 展示官方二维码（alipay.trade.precreate）
# → 国内/海外支付宝 App 扫码付款 → 支付宝服务器回调 /api/payments/webhook/alipay
# → 验签通过 → 订单标记已支付+金额、报名确认、自动成为会员、下发电子凭证。
# 兜底：回调丢失时，用户支付页轮询会向支付宝主动查单对账（alipay.trade.query）。
#
# 配置步骤（开放平台 open.alipay.com，需企业/个体工商户账号）：
#   ① 控制台 → 创建「网页/移动应用」→ 拿到 APPID（2021 开头）→ 填 ALIPAY_APP_ID
#   ② 「密钥工具」(opendocs.alipay.com/common/02kipk) 生成 RSA2 密钥对：
#      应用私钥 → 填 ALIPAY_PRIVATE_KEY；应用公钥 → 上传到开放平台「应用公钥」
#   ③ 上传后平台显示「支付宝公钥」（注意：是支付宝公钥，不是你的应用公钥！）
#      → 填 ALIPAY_PUBLIC_KEY（用于验签回调）
#   ④ 签约「当面付」（扫码支付能力），等待审核通过后支付才真实可用
#   ⑤ ALIPAY_NOTIFY_URL：公网 https 地址（须有效受信任证书，自签名收不到回调）
#      例：https://your-domain.org/api/payments/webhook/alipay
#
# 私钥/公钥格式：完整 PEM（可把换行写成 \n）或密钥工具导出的裸 base64 均可直接粘贴。
# 四项全部填齐后支付宝通道自动启用（GET /api/payments/providers 可确认）；
# 任一项缺失则通道隐藏，不影响其余功能。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
# 可选 — 官方网关默认生产环境；沙箱联调填 https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY=

# ── 8. 地图 ──
# 使用 MapLibre GL（WebGL）+ OpenStreetMap 免费瓦片渲染，无需任何 Key。
# 如需更换瓦片源，修改 app/components/site/MapLibreView.vue 的 sources。

# ── 9. 订单支付有效期（可选）────────────────────────────────────
# 未支付订单的存活分钟数：超时订单与其在线支付一并自动过期，
# 过期二维码不可再支付，需在支付页「重新生成订单」。
# 支付宝二维码有效期(timeout_express)与此联动。默认 15；测试可设 1 快速验证。
ORDER_TTL_MINUTES=15

# ── 10. 限流调节（可选）────────────────────────────────────────
# 全部接口限流阈值的整体倍率（只放大不缩小，默认 1）。
# 例：RATE_LIMIT_SCALE=3 时，发码 30/10分钟 → 90/10分钟。
# E2E 测试用 RATE_LIMIT_DISABLED=1 整体旁路（仅非生产生效）。
RATE_LIMIT_SCALE=1

# ── 11. 对象存储 OSS（投稿附件，S3 兼容 / docker compose 的 pps-minio 容器）──
# docker compose 已包含 pps-minio 容器（S3 兼容，端口 9000）；以下为开发默认值。
# 生产部署：修改 docker-compose 的 OSS_ROOT_USER/OSS_ROOT_PASSWORD（或 .env 覆盖），
# 并保证门户与管理台两边的 OSS_* 配置一致。
OSS_ENDPOINT=localhost
OSS_PORT=9100
OSS_USE_SSL=false
OSS_ACCESS_KEY=ppsoss
OSS_SECRET_KEY=pps-oss-dev-pw
OSS_BUCKET=pps-abstracts
